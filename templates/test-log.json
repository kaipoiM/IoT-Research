{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IoT Security Test Log Entry",
  "description": "Standardized test log format for three-state IoT security assessment",
  "type": "object",
  "required": ["test_id", "timestamp", "device", "configuration_state", "attack_vector", "procedure", "result"],
  "properties": {
    "test_id": {
      "type": "string",
      "description": "Unique identifier: {DEVICE_CODE}-{STATE}-{ATTACK_CODE}-{SEQ}",
      "examples": ["CAM-S1-MITM-001", "TV-S2-TLS-003", "LOCK-S1-BLE-002"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of test execution"
    },
    "device": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "examples": ["TP-Link Tapo C210"] },
        "model": { "type": "string" },
        "firmware_version": { "type": "string" },
        "ip_address": { "type": "string", "description": "Sanitized for publication — use generic placeholder" },
        "mac_address": { "type": "string", "description": "Sanitized for publication" }
      },
      "required": ["name", "firmware_version"]
    },
    "configuration_state": {
      "type": "integer",
      "enum": [1, 2, 3],
      "description": "1=Factory Default, 2=Vendor-Recommended Hardening, 3=Best-Practice Hardening"
    },
    "attack_vector": {
      "type": "string",
      "enum": [
        "MITM-ARP",
        "MITM-EVIL-TWIN",
        "SSL-TLS-INTERCEPT",
        "CREDENTIAL-DEFAULT",
        "CREDENTIAL-BRUTE-FORCE",
        "DEAUTH",
        "PORT-SCAN",
        "SERVICE-EXPLOIT",
        "PROTOCOL-FUZZ",
        "SUBGHZ-REPLAY",
        "SUBGHZ-JAM",
        "BLE-PROXIMITY",
        "BLE-SNIFF",
        "RFID-CLONE",
        "ZIGBEE-CAPTURE",
        "TRAFFIC-ANALYSIS"
      ]
    },
    "tools_used": {
      "type": "array",
      "items": { "type": "string" },
      "examples": [["bettercap", "SSLsplit"], ["Flipper Zero ESP32"], ["Nmap 7.94"]]
    },
    "procedure": {
      "type": "string",
      "description": "Step-by-step procedure executed"
    },
    "result": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "FAILURE", "INCONCLUSIVE"]
    },
    "mitigation_outcome": {
      "type": "string",
      "enum": ["PREVENTED", "PARTIALLY_MITIGATED", "FAILED_TO_MITIGATE", "N/A"],
      "description": "For States 2 & 3 — whether hardening mitigated the attack"
    },
    "time_to_compromise_minutes": {
      "type": ["number", "null"],
      "description": "Minutes elapsed from attack initiation to successful compromise. Null if attack failed."
    },
    "data_captured": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "examples": ["credentials", "video stream", "BLE keys"] },
        "sensitivity": { "type": "string", "enum": ["critical", "high", "medium", "low", "none"] },
        "volume_bytes": { "type": ["number", "null"] }
      }
    },
    "evidence_files": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Relative paths to pcap, screenshot, or RF capture files (sanitized)"
    },
    "owasp_category": {
      "type": "string",
      "enum": [
        "I1-Weak-Passwords",
        "I2-Insecure-Network-Services",
        "I3-Insecure-Ecosystem-Interfaces",
        "I4-Lack-Secure-Update",
        "I5-Insecure-Outdated-Components",
        "I6-Insufficient-Privacy-Protection",
        "I7-Insecure-Data-Transfer-Storage",
        "I8-Lack-Device-Management",
        "I9-Insecure-Default-Settings",
        "I10-Lack-Physical-Hardening"
      ]
    },
    "etsi_provision": {
      "type": "string",
      "description": "Relevant ETSI EN 303 645 provision (e.g., '5.1', '5.5')"
    },
    "observations": {
      "type": "string",
      "description": "Qualitative notes, unexpected behavior, or contextual findings"
    },
    "vulnerability_score": {
      "type": "object",
      "description": "IoT-adapted CVSS score for this specific finding",
      "properties": {
        "authentication_strength": { "type": "number", "minimum": 0, "maximum": 10 },
        "data_encryption": { "type": "number", "minimum": 0, "maximum": 10 },
        "attack_surface": { "type": "number", "minimum": 0, "maximum": 10 },
        "update_mechanism": { "type": "number", "minimum": 0, "maximum": 10 },
        "privacy_controls": { "type": "number", "minimum": 0, "maximum": 10 },
        "physical_security": { "type": "number", "minimum": 0, "maximum": 10 },
        "vendor_response": { "type": "number", "minimum": 0, "maximum": 10 },
        "weighted_total": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "next_steps": {
      "type": "string",
      "description": "Follow-up tests or actions required"
    },
    "cve_references": {
      "type": "array",
      "items": { "type": "string" },
      "examples": [["CVE-2025-15557"]]
    }
  }
}
